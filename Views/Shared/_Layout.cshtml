<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Student Management</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/StudentManagementSystem.styles.css"
          asp-append-version="true" />
</head>

<body class="bg-dark text-light">

    <div class="d-flex min-vh-100">

        <!-- Left Sidebar -->
        <aside class="d-flex flex-column flex-shrink-0
                      p-3 bg-black"
               style="width: 250px;">

            <!-- Brand -->
            <a asp-controller="Home"
               asp-action="Index"
               class="d-flex align-items-center
                      mb-4 text-white text-decoration-none">

                <span class="fs-5 fw-bold">
                    Student Management
                </span>

            </a>

            <hr class="border-secondary">

            <!-- Navigation -->
            <ul class="nav nav-pills flex-column gap-2">

                <li class="nav-item">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-link text-white">

                        Home

                    </a>

                </li>

                <li>

                    <a asp-controller="Students"
                       asp-action="Index"
                       class="nav-link text-white">

                        Students

                    </a>

                </li>


            </ul>

            <!-- Bottom -->
            <div class="mt-auto">

                <hr class="border-secondary">

                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="text-secondary text-decoration-none">

                    Privacy

                </a>

            </div>

        </aside>


        <!-- Main Content -->
        <div class="flex-grow-1">

            <main class="container-fluid p-4">

                @RenderBody()

            </main>

            <!-- Footer -->
            <footer class="border-top border-secondary
                           text-secondary mt-auto">

                <div class="container-fluid p-4">

                    <small>
                        © 2025 Student Management System
                    </small>

                </div>

            </footer>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>