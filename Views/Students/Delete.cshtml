@model Student
@{
    ViewData["Title"] = "Delete Student";
}
<h1>@ViewData["Title"]</h1>

<p>Are you sure you want to delete <strong>@Model.FullName</strong>?</p>

<form asp-action="DeleteConfirmed" asp-controller="Students" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Delete</button>
    <a asp-action="Index" asp-controller="Students">Cancel</a>
</form>
