@model IEnumerable<Student>

<h2>Student List</h2>
<a asp-controller="Students" asp-action="Create">Add Student</a>

<table class="table">
    <tr>
        <th>Name</th>
        <th>Department</th>
        <th>Semester</th>
        <th>Email</th>
        <th>Actions</th>
    </tr>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.FullName</td>
            <td>@s.Department</td>
            <td>@s.Semester</td>
            <td>@s.Email</td>
            <td>
                <a asp-action="Edit" asp-controller="Students" asp-route-id="@s.Id">Edit</a> |
                <a asp-action="Delete" asp-controller="Students" asp-route-id="@s.Id">Delete</a>
            </td>
        </tr>
    }
</table>
