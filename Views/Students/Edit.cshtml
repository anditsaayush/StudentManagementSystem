@model Student

@{
    ViewData["Title"] = "Edit Student";
}

<div class="py-4">

    <div class="mb-4">
        <h2 class="fw-semibold mb-1 text-white">Edit Student</h2>
        <p class="text-secondary mb-0">
            Update the student's information
        </p>
    </div>

    <div class="card bg-dark text-white border-secondary shadow-sm">

        <div class="card-body p-4 p-md-5">

            <form asp-controller="Students"
                  asp-action="Edit"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div class="row g-4">

                    <div class="col-12">
                        <label asp-for="FullName"
                               class="form-label fw-medium">
                            Full Name
                        </label>

                        <input asp-for="FullName"
                               class="form-control bg-dark text-white border-secondary"
                               placeholder="Enter student's full name" />

                        <span asp-validation-for="FullName"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Department"
                               class="form-label fw-medium">
                            Department
                        </label>

                        <input asp-for="Department"
                               class="form-control bg-dark text-white border-secondary"
                               placeholder="e.g. Computer Science" />

                        <span asp-validation-for="Department"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Semester"
                               class="form-label fw-medium">
                            Semester
                        </label>

                        <input asp-for="Semester"
                               type="number"
                               min="1"
                               class="form-control bg-dark text-white border-secondary"
                               placeholder="e.g. 4" />

                        <span asp-validation-for="Semester"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Email"
                               class="form-label fw-medium">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control bg-dark text-white border-secondary"
                               placeholder="student@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-5">

                    <a asp-controller="Students"
                       asp-action="Index"
                       class="btn btn-outline-light">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}