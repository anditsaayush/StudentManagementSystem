@model Student
@{
    ViewData["Title"] = "Create Student";
}
<h1>@ViewData["Title"]</h1>

<h2>Add Student</h2>

<form asp-action="Create" asp-controller="Students" method="post">

    <div>
        <label asp-for="FullName"></label>
        <input asp-for="FullName" />
        <span asp-validation-for="FullName"></span>
    </div>
    <div>
        <label asp-for="Department"></label>
        <input asp-for="Department" />
        <span asp-validation-for="Department"></span>
    </div>
    <div>
        <label asp-for="Semester"></label>
        <input asp-for="Semester" type="number" />
        <span asp-validation-for="Semester"></span>
    </div>
    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email"></span>
    </div>
    <button type="submit">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
