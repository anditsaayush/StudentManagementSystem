@{
    ViewData["Title"] = "Dashboard";
}

<div class="py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-semibold mb-1">Dashboard</h2>
            <p class="text-secondary mb-0">
                Overview of your student management system
            </p>
        </div>

        <a asp-controller="Students"
           asp-action="Create"
           class="btn btn-primary">
            + Add Student
        </a>

    </div>


    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <!-- Total Students -->
        <div class="col-md-4">

            <div class="card bg-dark border-secondary shadow-sm h-100">

                <div class="card-body p-4">

                    <p class="text-secondary mb-2 text-white">
                        Total Students
                    </p>

                    <h2 class="fw-bold mb-0 text-white">
                        @ViewBag.TotalStudents
                    </h2>

                </div>

            </div>

        </div>


        <!-- Departments -->
        <div class="col-md-4">

            <div class="card bg-dark border-secondary shadow-sm h-100">

                <div class="card-body p-4">

                    <p class="text-secondary mb-2 text-white">
                        Departments
                    </p>

                    <h2 class="fw-bold mb-0 text-white">
                        @ViewBag.TotalDepartments
                    </h2>

                </div>

            </div>

        </div>


        <!-- Semesters -->
        <div class="col-md-4">

            <div class="card bg-dark border-secondary shadow-sm h-100">

                <div class="card-body p-4">

                    <p class="text-secondary mb-2 text-white">
                        Semesters
                    </p>

                    <h2 class="fw-bold mb-0 text-white">
                        @ViewBag.TotalSemesters
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- Recent Students -->
    <div class="card bg-dark border-secondary shadow-sm">

        <div class="card-body p-0">

            <div class="p-4 border-bottom border-secondary
                        d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-1 fw-semibold text-white">
                        Recent Students
                    </h5>

                    <p class="text-secondary mb-0 small text-white">
                        Recently added students
                    </p>
                </div>

                <a asp-controller="Students"
                   asp-action="Index"
                   class="btn btn-outline-light btn-sm">
                    View All
                </a>

            </div>


            @if (ViewBag.RecentStudents.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-dark table-hover
                                  align-middle mb-0">

                        <thead>
                            <tr>
                                <th class="ps-4">Name</th>
                                <th>Department</th>
                                <th>Semester</th>
                                <th>Email</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var student in ViewBag.RecentStudents)
                            {
                                <tr>

                                    <td class="ps-4 fw-medium">
                                        @student.FullName
                                    </td>

                                    <td>
                                        @student.Department
                                    </td>

                                    <td>
                                        Semester @student.Semester
                                    </td>

                                    <td>
                                        @student.Email
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="p-5 text-center">

                    <p class="text-secondary mb-3">
                        No students have been added yet.
                    </p>

                    <a asp-controller="Students"
                       asp-action="Create"
                       class="btn btn-primary">
                        Add First Student
                    </a>

                </div>
            }

        </div>

    </div>

</div>